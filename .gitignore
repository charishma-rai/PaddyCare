*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
ENV/
env/

# Keep directory structure
!**/.gitkeep

# Secrets and local configurations
.streamlit/secrets.toml
.env
.DS_Store
Thumbs.db

